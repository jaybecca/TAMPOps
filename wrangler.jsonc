{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tampops",
  "compatibility_date": "2026-10-03",
  "main": "worker.js",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{"binding": "EVENTS_MEDIA", "bucket_name": "tampops-events"}],
  "routes": [
    {
      "pattern": "tampops.tampconsulting.space",
      "custom_domain": true
    }
  ]
}
